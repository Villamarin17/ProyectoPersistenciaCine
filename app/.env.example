# Copie este archivo como .env y complete los valores. .env no se sube al repositorio.
PORT=3000
SESSION_SECRET=cambie-esta-cadena-por-una-larga-y-aleatoria

# Oracle (ESTUD del curso, Oracle Free en Docker u otro)
ORACLE_USER=CINECONECTA
ORACLE_PASSWORD=
# Formato servidor:puerto/servicio. Si ESTUD está configurado como SID, usar:
# (DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=servidor)(PORT=1521))(CONNECT_DATA=(SID=ESTUD)))
ORACLE_CONNECT_STRING=servidor:1521/ESTUD
# Solo si la aplicación se conecta con un usuario distinto al dueño de las tablas (ver oracle/04_usuario_app.sql)
ORACLE_SCHEMA=

# MongoDB (Atlas o local con conjunto de réplicas)
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/
MONGODB_DB=cineconecta
