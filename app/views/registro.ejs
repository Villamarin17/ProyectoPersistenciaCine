<%- include('partials/header') %>
<section class="card narrow">
  <h1>Crear cuenta</h1>
  <% if (typeof error !== 'undefined') { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/registro" class="form">
    <label>Nombre completo <input name="fullName" maxlength="150" value="<%= form.fullName || '' %>" required></label>
    <label>Correo <input type="email" name="email" maxlength="254" value="<%= form.email || '' %>" required></label>
    <label>Contraseña (mínimo 8 caracteres) <input type="password" name="password" minlength="8" required></label>
    <button class="btn">Crear cuenta</button>
  </form>
</section>
<%- include('partials/footer') %>
