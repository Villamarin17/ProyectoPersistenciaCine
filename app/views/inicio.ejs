<%- include('partials/header') %>
<h1>Hola, <%= profile.profileName %></h1>
<h2>Continuar viendo</h2>
<% if (!items.length) { %>
  <p class="muted">Aún no hay nada a medias. <a href="/catalogo">Explore el catálogo</a>.</p>
<% } else { %>
<div class="grid">
  <% items.forEach(i => { %>
  <div class="poster">
    <img src="<%= i.coverUrl %>" alt="" loading="lazy" onerror="this.style.visibility='hidden'">
    <span class="ptitle"><%= i.title %></span>
    <% if (i.episodeLabel) { %><span class="small"><%= i.episodeLabel %></span><% } %>
    <div class="bar"><div style="width:<%= Math.min(100, Math.round(100 * i.positionSec / i.durationSec)) %>%"></div></div>
    <span class="muted small"><%= f.clock(i.positionSec) %> de <%= f.clock(i.durationSec) %> · <%= f.dateTime(i.lastWatchedAt) %></span>
    <form method="post" action="/reproducir/<%= encodeURIComponent(i._id) %>">
      <% if (i.episodeId) { %><input type="hidden" name="episodeId" value="<%= i.episodeId %>"><% } %>
      <button class="btn small">Reanudar</button>
    </form>
  </div>
  <% }) %>
</div>
<% } %>
<%- include('partials/footer') %>
